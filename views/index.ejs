<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="forms-wrapper" id="formsWrapper">

            <!-- ==================== ФОРМА ВХОДА ==================== -->
            <section class="form-box login-box" aria-labelledby="login-title">
                <h2 id="login-title">Вход</h2>
                <form id="loginForm" novalidate>
                    <div class="input-group">
                        <input type="email" name="email" placeholder="Email"
                               required autocomplete="email" maxlength="254">
                    </div>
                    <div class="input-group">
                        <input type="password" name="password" placeholder="Пароль"
                               required autocomplete="current-password" minlength="8">
                    </div>

                    <!-- honeypot: невидимое поле для ботов -->
                    <input type="text" name="honeypot" class="honeypot"
                           tabindex="-1" autocomplete="off" aria-hidden="true">

                    <button type="submit" class="btn" id="loginBtn">
                        <span class="btn-text">Войти</span>
                        <span class="btn-spinner" hidden></span>
                    </button>
                    <div class="message" id="loginMessage" role="alert"></div>
                </form>

                <p class="toggle-text">
                    Нет аккаунта?
                    <span class="toggle-link" data-target="register" tabindex="0" role="button">
                        Зарегистрироваться
                    </span>
                </p>
            </section>

            <!-- ==================== ФОРМА РЕГИСТРАЦИИ ==================== -->
            <section class="form-box register-box" aria-labelledby="register-title">
                <h2 id="register-title">Регистрация</h2>
                <form id="registerForm" novalidate>
                    <div class="input-group">
                        <input type="text" name="name" placeholder="Имя"
                               required minlength="2" maxlength="60" autocomplete="name">
                    </div>
                    <div class="input-group">
                        <input type="email" name="email" placeholder="Email"
                               required autocomplete="email" maxlength="254">
                    </div>
                    <div class="input-group">
                        <input type="password" name="password"
                               placeholder="Пароль (мин. 8 символов)"
                               required minlength="8" autocomplete="new-password">
                    </div>

                    <div class="consent-group">
                        <label>
                            <input type="checkbox" name="privacyConsent" required>
                            <span>Я согласен с
                                <a href="/privacy" target="_blank" rel="noopener">политикой конфиденциальности</a>
                            </span>
                        </label>
                    </div>

                    <input type="text" name="honeypot" class="honeypot"
                           tabindex="-1" autocomplete="off" aria-hidden="true">

                    <button type="submit" class="btn" id="registerBtn">
                        <span class="btn-text">Создать аккаунт</span>
                        <span class="btn-spinner" hidden></span>
                    </button>
                    <div class="message" id="registerMessage" role="alert"></div>
                </form>

                <p class="toggle-text">
                    Уже есть аккаунт?
                    <span class="toggle-link" data-target="login" tabindex="0" role="button">
                        Войти
                    </span>
                </p>
            </section>

        </div>
    </div>

    <script src="/js/auth.js" defer></script>
</body>
</html>
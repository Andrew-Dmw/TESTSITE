<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title %></title>
    <link rel="icon" href="/images/favicon/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">

    <aside class="admin-sidebar">
        <div class="admin-logo">
            <span class="admin-logo-mark">⚖</span>
            <span>Админ-панель</span>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-section">Обзор</div>
            <a href="/admin"><span class="admin-nav-icon">📊</span> Дашборд</a>

            <div class="admin-nav-section">Работа</div>
            <a href="/admin/leads" class="active">
                <span class="admin-nav-icon">📥</span> Заявки
            </a>
            <a href="/admin/users"><span class="admin-nav-icon">👥</span> Пользователи</a>

            <div class="admin-nav-section">Безопасность</div>
            <a href="/admin/incidents"><span class="admin-nav-icon">⚠️</span> Инциденты</a>

            <div class="admin-nav-section">На сайт</div>
            <a href="/"><span class="admin-nav-icon">🏠</span> Главная</a>
            <a href="/main"><span class="admin-nav-icon">👤</span> Личный кабинет</a>
        </nav>

        <div class="admin-sidebar-footer">
            <span class="admin-user-name"><%= user.name %></span>
            <span class="admin-user-email"><%= user.email %></span>
            <form action="/logout" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="admin-logout">Выйти</button>
            </form>
        </div>
    </aside>

    <main class="admin-main">

        <div class="admin-header">
            <h1>Заявки</h1>
            <p>Управление входящими обращениями с сайта</p>
        </div>

        <!-- Фильтры -->
        <div class="filter-tabs">
            <a href="/admin/leads" class="filter-tab <%= currentFilter === 'all' ? 'active' : '' %>">
                Все <span class="count"><%= counts.new + counts.in_progress + counts.done + counts.rejected %></span>
            </a>
            <a href="/admin/leads?status=new" class="filter-tab <%= currentFilter === 'new' ? 'active' : '' %>">
                Новые <span class="count"><%= counts.new %></span>
            </a>
            <a href="/admin/leads?status=in_progress" class="filter-tab <%= currentFilter === 'in_progress' ? 'active' : '' %>">
                В работе <span class="count"><%= counts.in_progress %></span>
            </a>
            <a href="/admin/leads?status=done" class="filter-tab <%= currentFilter === 'done' ? 'active' : '' %>">
                Завершённые <span class="count"><%= counts.done %></span>
            </a>
            <a href="/admin/leads?status=rejected" class="filter-tab <%= currentFilter === 'rejected' ? 'active' : '' %>">
                Отказы <span class="count"><%= counts.rejected %></span>
            </a>
        </div>

        <div class="admin-card">
            <div class="admin-card-body no-pad">
                <% if (leads.length === 0) { %>
                    <table class="admin-table">
                        <tr class="empty-row"><td>Заявок с таким статусом нет</td></tr>
                    </table>
                <% } else { %>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Клиент</th>
                                <th>Сообщение</th>
                                <th>Источник</th>
                                <th>Дата</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% leads.forEach(lead => { %>
                                <tr data-lead-id="<%= lead.id %>">
                                    <td class="cell-mono">#<%= lead.id %></td>
                                    <td>
                                        <span class="cell-name"><%= lead.name %></span>
                                        <span class="cell-contact"><%= lead.contact %></span>
                                    </td>
                                    <td class="cell-message"><%= lead.message || '—' %></td>
                                    <td class="cell-muted"><%= lead.source || 'direct' %></td>
                                    <td class="cell-muted"><%= new Date(lead.created_at).toLocaleString('ru-RU') %></td>
                                    <td>
                                        <span class="badge badge-<%= lead.status %>" data-status-label><%= lead.status %></span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="btn-mini primary" data-set-status="in_progress">В работу</button>
                                            <button class="btn-mini gold" data-set-status="done">Готово</button>
                                            <button class="btn-mini danger" data-set-status="rejected">Отказ</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

    </main>
</div>

<script src="/js/admin-leads.js"></script>
</body>
</html>
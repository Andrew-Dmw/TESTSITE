<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Профиль — Юрист в Усть-Куте</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="icon" href="/images/favicon/favicon.ico" type="image/x-icon">
</head>
<body>
    <header class="profile-header">
        <div class="container header-inner">
            <a href="/" class="logo">
                <span class="logo-mark">⚖</span>
                <span class="logo-text">Юрист в Усть-Куте</span>
            </a>
            <nav class="profile-nav">
                <a href="/">Главная</a>
                <a href="/main">Личный кабинет</a>
                <a href="/services">Услуги</a>
                <a href="/ER">Демо-модель</a>
            </nav>
        </div>
    </header>

    <main class="profile-main">
        <div class="container">

            <div class="page-title">
                <h1>Профиль пользователя</h1>
                <p class="subtitle">Управление аккаунтом и безопасностью</p>
            </div>

            <!-- Карточка с данными -->
            <section class="profile-card">
                <h2>Личные данные</h2>

                <div class="field">
                    <span class="field-label">Имя</span>
                    <span class="field-value"><%= user.name %></span>
                </div>

                <div class="field">
                    <span class="field-label">Email</span>
                    <span class="field-value"><%= user.email %></span>
                </div>

                <div class="field">
                    <span class="field-label">Роль</span>
                    <span class="field-value">
                        <%= user.role === 'admin' ? 'Администратор' : 'Клиент' %>
                    </span>
                </div>
            </section>

            <!-- Безопасность -->
            <section class="profile-card">
                <h2>Безопасность</h2>

                <div class="info-row">
                    <div class="info-text">
                        <strong>Выход из аккаунта</strong>
                        <p>Завершить текущую сессию на этом устройстве.</p>
                    </div>
                    <form action="/logout" method="post" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-danger">Выйти</button>
                    </form>
                </div>
            </section>

            <!-- Управление ПДн (152-ФЗ) -->
            <section class="profile-card">
                <h2>Управление персональными данными</h2>
                <p class="muted">
                    В соответствии с ФЗ-152 вы можете отозвать согласие на обработку,
                    удалить свои данные или выгрузить их копию.
                </p>

                <div class="actions-row">
                    <a href="/ER" class="btn-secondary">
                        Перейти к управлению ПДн
                    </a>
                    <a href="/export-data" class="btn-secondary">
                        Скачать копию данных (JSON)
                    </a>
                </div>
            </section>

            <!-- Кнопка на главную -->
            <div class="back-row">
                <a href="/main" class="back-link">← Вернуться в личный кабинет</a>
            </div>

        </div>
    </main>

    <footer class="profile-footer">
        <div class="container">
            <p>&copy; 2026 ИП Дмитриев А.К. Юридические услуги в Усть-Куте.</p>
            <p><a href="/privacy">Политика конфиденциальности</a></p>
        </div>
    </footer>
</body>
</html>